.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment & Secrets (NEVER COMMIT SENSITIVE API KEYS)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example
*.pem
*.key
*.crt
credentials*.json
client_secret*.json
serviceAccountKey*.json
token.json

# Agents & Skills (NEVER COMMIT SKILLS TO REPO)
.agents/
.gemini/
skills/
skills-lock.json

# OS & Filesystem Metadata
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# IDE & Editor Configs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Logs & Runtime Dumps
logs/
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.system_generated/
*.pid
*.seed
*.pid.lock

# Test & Coverage Outputs
coverage/
.nyc_output/
*.lcov
.clinic/

# Build & Temporary Files
dist/
build/
out/
.temp/
.tmp/
tmp/
temp/

# Backup & Scratch Files
*.bak
*.old
*.orig
scratch/
.agents/

# Large Binaries & Raw Documents
*.zip
*.pdf
*.docx
Biology-Chapter-PDFs/
Mathematics-Chapter-PDFs/

